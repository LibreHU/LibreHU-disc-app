<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Root asked for every LibreHU app at once (LibreHU Launcher): requests and answers between apps signed with
         the LibreHU key only. Defined by every LibreHU app, so that it exists whatever the install order. -->
    <permission
        android:name="org.librehu.permission.ROOT_REQUEST"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.librehu.permission.ROOT_REQUEST" />

    <!-- Playback in the background with its notification. -->
    <!-- MusicBrainz / Cover Art Archive: album, titles and cover of audio CDs (option) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network back: the discs seen offline are looked up then. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- CD rip: Music/LibreHU Disc on Android 9; a folder picked with the system's picker needs nothing. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <!-- VLC opens a DVD (whole disc as an ISO image) with its menus; any viewer for the other files. -->
        <package android:name="org.videolan.vlc" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <provider android:authorities="org.librehu.launcher.theme" />
    </queries>

    <!-- LibreHU apps (same signing key): LibreHU-service's bridge reads and changes this app's settings for the phone app. -->
    <permission
        android:name="org.librehu.permission.BRIDGE"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibreHU.Car">
        <!-- Single-colour icon: LibreHU Launcher draws it in the colours of its theme. -->
        <meta-data
            android:name="org.librehu.themed_icon"
            android:resource="@drawable/ic_launcher_mono" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity>

        <!-- Media session, notification and browser tree (LibreHU EasySource lists the CD tracks). -->
        <service
            android:name=".player.DiscService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- CD rip in the background, with its progress. -->
        <service
            android:name=".rip.RipService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".player.ControlReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.librehu.disc.action.TOGGLE" />
                <action android:name="org.librehu.disc.action.NEXT" />
                <action android:name="org.librehu.disc.action.PREVIOUS" />
            </intent-filter>
        </receiver>

        <!-- LibreHU Launcher's first start: root asked for every LibreHU app at once (RootRequestReceiver). -->
        <receiver
            android:name=".RootRequestReceiver"
            android:exported="true"
            android:permission="org.librehu.permission.ROOT_REQUEST">
            <intent-filter>
                <action android:name="org.librehu.action.REQUEST_ROOT" />
            </intent-filter>
        </receiver>

        <!-- Files of the mounted disc and the whole disc as an ISO image, read-only, by URI grant. -->
        <provider
            android:name=".DiscFileProvider"
            android:authorities="org.librehu.disc.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Settings pages for LibreHU's phone app, read and changed by LibreHU-service's bridge (.bridge.BridgeProvider). -->
        <provider
            android:name=".bridge.BridgeProvider"
            android:authorities="org.librehu.disc.bridge"
            android:exported="true"
            android:permission="org.librehu.permission.BRIDGE" />
    </application>
</manifest>
